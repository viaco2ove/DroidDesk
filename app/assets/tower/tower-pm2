#!/usr/bin/env python3
"""
tower-pm2 CLI — pm2 风格命令行客户端（操作 Tower PM2 模块注册表）
──────────────────────────────────────────────────────────────────
所有命令通过 HTTP API (127.0.0.1:7088) 与 Tower 面板通信。
TCP 通信保证 pid 一致性：无论从哪个 proot 实例执行，结果一致。

注意：tower-pm2 只操作 Tower PM2 模块的注册表（/etc/tower/pm2.json），
     与 Service 模块（/etc/tower/services.json）无关。

命令（与 pm2 对齐）:
  tower-pm2 list | status | ls          列出 Tower PM2 托管的服务
  tower-pm2 jlist                       JSON 格式输出
  tower-pm2 start <name>                启动服务
  tower-pm2 stop <name>                 停止服务
  tower-pm2 restart <name>              重启服务
  tower-pm2 delete <name>               删除服务（停止并移除注册）
  tower-pm2 add <name> <cmd> [选项]      添加服务
  tower-pm2 logs <name> [lines]         查看服务日志
  tower-pm2 monit                       实时监控（2s 刷新，Ctrl+C 退出）
  tower-pm2 on | off                    启用/停用 Tower PM2 模块
  tower-pm2 ping                        检查面板是否存活
"""

import sys
import json
import time
import subprocess
import urllib.request
import urllib.error
from pathlib import Path

API = "http://127.0.0.1:7088"
LOG_DIR = "/var/log/tower"


def api_get(path: str, timeout: int = 5) -> dict:
    try:
        with urllib.request.urlopen(API + path, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8"))
    except Exception as e:
        return {"ok": False, "error": f"tower-pm2 daemon unreachable: {e}"}


def api_post(path: str, data: dict = None, timeout: int = 30) -> dict:
    try:
        req = urllib.request.Request(
            API + path, method="POST",
            data=json.dumps(data or {}).encode("utf-8"),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8"))
    except Exception as e:
        return {"ok": False, "error": f"tower-pm2 daemon unreachable: {e}"}


def disp_width(s: str) -> int:
    return sum(2 if ord(c) > 0x2E7F else 1 for c in s)


def pad(s: str, width: int) -> str:
    return s + " " * max(0, width - disp_width(s))


def print_table(services: dict) -> None:
    rows = []
    for idx, (name, st) in enumerate(sorted(services.items())):
        status = st.get("status", "stopped")
        icon = "●" if status == "online" else ("◐" if status == "crash_loop" else "○")
        rows.append({
            "id": str(idx),
            "name": name,
            "mode": "fork",
            "rc": str(st.get("restart_count", 0)),
            "status": f"{icon} {status}",
            "pid": str(st.get("pid") or "-"),
            "cpu": f"{st.get('cpu', 0)}%",
            "mem": str(st.get("mem", "-")),
            "uptime": str(st.get("uptime", "-")),
        })

    headers = {"id": "id", "name": "name", "mode": "mode", "rc": "↺",
               "status": "status", "pid": "pid", "cpu": "cpu",
               "mem": "memory", "uptime": "uptime"}
    cols = list(headers)
    widths = {}
    for c in cols:
        w = disp_width(headers[c])
        for r in rows:
            w = max(w, disp_width(r[c]))
        widths[c] = w

    if not rows:
        print("no services in Tower PM2 registry. use: tower-pm2 add <name> <cmd>")
        return

    sep = "├" + "┼".join("─" * (widths[c] + 2) for c in cols) + "┤"
    top = "┌" + "┬".join("─" * (widths[c] + 2) for c in cols) + "┐"
    bot = "└" + "┴".join("─" * (widths[c] + 2) for c in cols) + "┘"
    head = "│ " + " │ ".join(pad(headers[c], widths[c]) for c in cols) + " │"

    print(top)
    print(head)
    print(sep)
    for r in rows:
        print("│ " + " │ ".join(pad(r[c], widths[c]) for c in cols) + " │")
    print(bot)


def cmd_list(args):
    r = api_get("/api/pm2/status")
    if not r.get("ok"):
        print(f"error: {r.get('error')}", file=sys.stderr)
        return 5
    svc = r.get("services", {})
    if "--json" in args:
        out = [{"id": i, "name": n, "mode": "fork", **st} for i, (n, st) in enumerate(sorted(svc.items()))]
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0
    print_table(svc)
    return 0


def _require_name(args):
    if len(args) < 1:
        print("error: service name required", file=sys.stderr)
        sys.exit(2)
    return args[0]


def cmd_start(args):
    name = _require_name(args)
    r = api_post(f"/api/pm2/start/{name}")
    print(r.get("error") or f"[{name}] started (PID {r.get('pid')})" if r.get("ok") else r.get("error"))
    return 0 if r.get("ok") else 1


def cmd_stop(args):
    name = _require_name(args)
    r = api_post(f"/api/pm2/stop/{name}")
    print(r.get("error") or f"[{name}] stopped")
    return 0 if r.get("ok") else 1


def cmd_restart(args):
    name = _require_name(args)
    r = api_post(f"/api/pm2/restart/{name}")
    print(r.get("error") or f"[{name}] restarted (PID {r.get('pid')})" if r.get("ok") else r.get("error"))
    return 0 if r.get("ok") else 1


def cmd_delete(args):
    name = _require_name(args)
    r = api_post(f"/api/pm2/delete/{name}")
    print(r.get("error") or f"[{name}] deleted")
    return 0 if r.get("ok") else 1


def cmd_add(args):
    if len(args) < 2:
        print("usage: tower-pm2 add <name> <cmd|script> [--cwd dir] [--keep-live] [--start-with-os]", file=sys.stderr)
        return 2
    name, target = args[0], args[1]
    cwd, keep_live, start_with_os = "/", False, False
    i = 2
    while i < len(args):
        a = args[i]
        if a in ("--cwd", "-w") and i + 1 < len(args):
            cwd = args[i + 1]; i += 2
        elif a in ("--keep-live", "-k"):
            keep_live = True; i += 1
        elif a in ("--start-with-os", "-s"):
            start_with_os = True; i += 1
        else:
            i += 1
    r = api_post("/api/pm2/add", {
        "name": name, "cmd": target, "cwd": cwd,
        "keep_live": keep_live, "start_with_os": start_with_os,
    })
    print(r.get("error") or f"[{name}] added")
    return 0 if r.get("ok") else 1


def cmd_logs(args):
    name = _require_name(args)
    lines = int(args[1]) if len(args) > 1 and args[1].isdigit() else 50
    for suffix in (".out.log", ".err.log"):
        p = Path(LOG_DIR) / f"{name}{suffix}"
        if p.exists():
            print(f"──── {p} (last {lines} lines) ────")
            subprocess.run(["tail", "-n", str(lines), str(p)])
    return 0


def cmd_monit(args):
    try:
        while True:
            r = api_get("/api/pm2/status")
            if r.get("ok"):
                subprocess.run("clear" if sys.platform != "win32" else "cls", shell=True)
                print_table(r.get("services", {}))
                print("(Ctrl+C to exit, refresh 2s)")
            time.sleep(2)
    except KeyboardInterrupt:
        pass
    return 0


def cmd_on(args):
    r = api_post("/api/pm2/enable")
    print(r.get("error") or f"tower-pm2 enabled{', started: ' + ','.join(r['started']) if r.get('started') else ''}")
    return 0 if r.get("ok") else 1


def cmd_off(args):
    r = api_post("/api/pm2/disable")
    print(r.get("error") or f"tower-pm2 disabled{', stopped: ' + ','.join(r['stopped']) if r.get('stopped') else ''}")
    return 0 if r.get("ok") else 1


def cmd_ping(args):
    r = api_get("/api/system", timeout=3)
    if r.get("ok"):
        print("tower-pm2 online")
        return 0
    print("tower-pm2 offline")
    return 5


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 0
    cmd, args = sys.argv[1], sys.argv[2:]

    handlers = {
        "list": cmd_list, "status": cmd_list, "ls": cmd_list, "ps": cmd_list,
        "jlist": cmd_list,
        "start": cmd_start, "stop": cmd_stop, "restart": cmd_restart,
        "delete": cmd_delete, "remove": cmd_delete, "rm": cmd_delete, "del": cmd_delete,
        "add": cmd_add, "logs": cmd_logs, "monit": cmd_monit,
        "on": cmd_on, "off": cmd_off,
        "ping": cmd_ping,
        "-h": lambda a: (print(__doc__), 0)[1],
        "--help": lambda a: (print(__doc__), 0)[1],
    }
    fn = handlers.get(cmd)
    if not fn:
        print(f"unknown command: {cmd} (try --help)", file=sys.stderr)
        return 2
    return fn(args)


if __name__ == "__main__":
    sys.exit(main() or 0)